<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.agenxy.supgang.runtime</string>
    <key>CFBundleName</key>
    <string>Supgang</string>
    <key>CFBundleDisplayName</key>
    <string>Supgang</string>
    <key>CFBundleExecutable</key>
    <string>supgang</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>@SHORT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@SHORT_VERSION@</string>
    <key>SupgangReleaseVersion</key>
    <string>@RELEASE_VERSION@</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright Agenxy contributors. Licensed under Apache-2.0.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Supgang connects to your paired computers to keep their addresses up to date.</string>
</dict>
</plist>
